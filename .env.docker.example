# Desktop-first Docker baseline
APP_NAME=MTI Alert Backend
NODE_ENV=production
LOG_LEVEL=info

# Host and container ports
BACKEND_PORT=4019
BACKEND_HOST_PORT=4019
FRONTEND_PORT=8080
FRONTEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432

# Release-scope guardrails
ENABLED_DELIVERY_CHANNELS=WindowsAgent
VITE_ENABLED_DELIVERY_CHANNELS=DesktopAgent
DOCKER_VITE_API_URL=/api
# Leave empty to derive the realtime URL from the inbound request host.
# Set this only when agents must connect through a different public host or proxy.
BACKEND_PUBLIC_BASE_URL=

# Session handling
ADMIN_SESSION_TTL_MINUTES=480
AGENT_SESSION_TTL_MINUTES=480

# Optional PostgreSQL container bootstrap
# Only used when running docker-compose.with-postgres.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ictMTIAlertHub

# Backend database connection
# Default deployment expects an external or already-managed PostgreSQL instance.
POSTGRES_URL=postgresql://postgres:change-me@db.example.internal:5432/ictMTIAlertHub
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=ictMTIAlertHub
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# LDAP / Active Directory
LDAP_URL=ldaps://directory.example.internal:636
LDAP_BIND_DN=CN=Service Account,OU=Service Accounts,DC=example,DC=internal
LDAP_BIND_PASSWORD=change-me
LDAP_BASE_DN=DC=example,DC=internal
LDAP_SEARCH_BASE=OU=Users,DC=example,DC=internal
LDAP_ALLOWED_GROUPS=CN=VPN-IT,OU=Groups,DC=example,DC=internal
LDAP_ALLOW_INSECURE_URL=false
LDAP_SKIP_TLS_VERIFY=false
